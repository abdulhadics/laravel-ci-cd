pipeline {
    agent any
    environment {
        VM_IP = '127.0.0.1'
        VM_USER = 'haxdi'
        SSH_PORT = '2222'
        DEPLOY_DIR = '/var/www/laravel-app'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Package Application') {
            steps {
                bat 'tar.exe -a -c -f app.zip *'
            }
        }
        stage('Deploy to VM') {
            steps {
                sshagent(credentials: ['vm-deploy-key']) {
                    bat "scp -P %SSH_PORT% -o StrictHostKeyChecking=no app.zip %VM_USER%@%VM_IP%:~/"
                    bat """ssh -p %SSH_PORT% -o StrictHostKeyChecking=no %VM_USER%@%VM_IP% "sudo mkdir -p %DEPLOY_DIR% && sudo chown %VM_USER%:%VM_USER% %DEPLOY_DIR% && sudo apt-get update && sudo apt-get install -y unzip php-cli composer && unzip -o ~/app.zip -d %DEPLOY_DIR% && cd %DEPLOY_DIR% && composer install --no-dev && cp .env.example .env && php artisan key:generate" """
                }
            }
        }
    }
}
